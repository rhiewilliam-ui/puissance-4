<Window x:Class="SAE_IHM_Interface.FenetreAccueil"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SAE_IHM_Interface"
        mc:Ignorable="d"
        Title="Accueil"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource AppBackground}"
        FontFamily="Segoe UI"
        Height="450"
        Width="800">

    <Grid>

        <Viewbox Stretch="Uniform"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Grid x:Name="Interface">
                <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Orientation="Vertical"
                    Margin="0,0,0,0">

                    <Image Source="/Assets/logo.png"
                           Width="160" Height="138"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>
                    <TextBlock Text="PUISSANCE 4"
                               FontSize="46" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Aligne 4 jetons pour gagner"
                               FontSize="16"
                               Foreground="{StaticResource TextSecondary}"
                               HorizontalAlignment="Center"
                               Margin="0,2,0,30"/>

                    <Button x:Name="Bouton_Jouer"
                        Style="{StaticResource PrimaryButton}"
                        Width="350"
                        Height="58"
                        FontSize="20"
                        Margin="0 6"
                        Click="Bouton_Jouer_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Assets/play_blue.png" Width="20" Height="20"
                                   Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Jouer" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="Bouton_reprendre"
                        Width="250"
                        Height="50"
                        Margin="0 6"
                        Opacity="0.4"
                        IsEnabled="False">
                        Reprendre
                    </Button>

                    <Button x:Name="Bouton_parametres"
                        Width="250"
                        Height="50"
                        Margin="0 6"
                        Click="Bouton_Parametres_Click">
                        Paramètres
                    </Button>

                    <Button x:Name="Bouton_replay"
                        Width="250"
                        Height="50"
                        Margin="0 6"
                        Click="Bouton_Replay_Click">
                        Replay
                    </Button>
                </StackPanel>
            </Grid>
        </Viewbox>

        <Grid x:Name="Overlay"
            Background="#A6101A2E"
            Visibility="Collapsed">

            <Border Width="560"
                Height="250"
                Style="{StaticResource Card}"
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <Button Click="FermerOverlay_Click"
                            Width="25"
                            Height="25"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            BorderBrush="White"
                            Grid.ColumnSpan="2">
                        X
                    </Button>

                    <Button Click="Bouton_IA_Click"
                            Width="220"
                            Height="100"
                            FontSize="16"
                            Grid.Row="1"
                            Grid.Column="0">
                        IA
                    </Button>

                    <Button Click="Bouton_Humain_Click"
                            Width="220"
                            Height="100"
                            FontSize="16"
                            Grid.Row="1"
                            Grid.Column="1">
                        Humain
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
