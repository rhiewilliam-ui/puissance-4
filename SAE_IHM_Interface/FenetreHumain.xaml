<Window x:Class="SAE_IHM_Interface.FenetreHumain"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SAE_IHM_Interface"
        mc:Ignorable="d"
        Title="Configuration du duel"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource AppBackground}"
        FontFamily="Segoe UI"
        Height="450"
        Width="800">

    <Window.Resources>

        <Style x:Key="SliderStyleCustom" TargetType="Slider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Height="2"
                            Background="Black"
                            VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track"
                           Minimum="{TemplateBinding Minimum}"
                           Maximum="{TemplateBinding Maximum}"
                           Value="{TemplateBinding Value}"
                           VerticalAlignment="Center">
                                <Track.Thumb>
                                    <Thumb Width="15" Height="15">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="White"
                                                    BorderBrush="Black"
                                                    BorderThickness="2"
                                                    CornerRadius="35"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Viewbox Stretch="Uniform"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <StackPanel Orientation="Vertical"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Width="750">

                <Grid Margin="0 0 0 40">

                    <Border BorderBrush="Black"
                        BorderThickness="2"
                        CornerRadius="8"
                        Background="White"
                        Padding="20"
                        Width="700">

                        <StackPanel Orientation="Vertical"
                            HorizontalAlignment="Center">

                            <TextBlock x:Name="LabelTempsJ1"
                               FontSize="18"
                               HorizontalAlignment="Center"
                               Margin="0 0 0 10">
                               30 s
                            </TextBlock>

                            <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">

                                <Button x:Name="Bouton_moins_tempsJ1"
                                    Width="35" Height="35"
                                    BorderBrush="Black"
                                    BorderThickness="2"
                                    Background="White"
                                    Click="Bouton_moins_tempsJ1_Click"
                                    FontSize="25">
                                    -
                                </Button>

                                <Slider x:Name="SliderTempsJ1"
                                    Minimum="0"
                                    Maximum="6"
                                    Value="2"
                                    Width="550"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    ValueChanged="SliderTempsJ1_ValueChanged"
                                    Style="{StaticResource SliderStyleCustom}"/>

                                <Button x:Name="Bouton_plus_tempsJ1"
                                    Width="35" Height="35"
                                    BorderBrush="Black"
                                    BorderThickness="2"
                                    Background="White"
                                    Click="Bouton_plus_tempsJ1_Click"
                                    FontSize="25">
                                    +
                                </Button>

                            </StackPanel>

                        </StackPanel>

                    </Border>

                    <TextBlock Text="Temps J1"
                       FontSize="20"
                       FontWeight="Bold"
                       Background="White"
                       Padding="5 0"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       Margin="40,-12,0,0"/>
                </Grid>

                <Grid Margin="0,0,0,25">

                    <Border BorderBrush="Black"
                        BorderThickness="2"
                        CornerRadius="8"
                        Background="White"
                        Padding="20"
                        Width="700">

                        <StackPanel Orientation="Vertical"
                            HorizontalAlignment="Center">

                            <TextBlock x:Name="LabelTempsJ2"
                                FontSize="18"
                                HorizontalAlignment="Center"
                                Margin="0 0 0 10">
                                30 s
                            </TextBlock>

                            <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">

                                <Button x:Name="Bouton_moins_tempsJ2"
                                    Width="35" Height="35"
                                    BorderBrush="Black"
                                    BorderThickness="2"
                                    Background="White"
                                    Click="Bouton_moins_tempsJ2_Click"
                                    FontSize="25">
                                    -
                                </Button>

                                <Slider x:Name="SliderTempsJ2"
                                    Minimum="0"
                                    Maximum="6"
                                    Value="2"
                                    Width="550"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    ValueChanged="SliderTempsJ2_ValueChanged"
                                    Style="{StaticResource SliderStyleCustom}"/>

                                <Button x:Name="Bouton_plus_tempsJ2"
                                    Width="35" Height="35"
                                    BorderBrush="Black"
                                    BorderThickness="2"
                                    Background="White"
                                    Click="Bouton_plus_tempsJ2_Click"
                                    FontSize="25">
                                    +
                                </Button>

                            </StackPanel>

                        </StackPanel>

                    </Border>

                    <TextBlock Text="Temps J2"
                       FontSize="20"
                       FontWeight="Bold"
                       Background="White"
                       Padding="5 0"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       Margin="40,-14,0,0"/>
                </Grid>

                <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">

                    <Button x:Name="Bouton_retour"
                        Click="Bouton_retour_Click"
                        FontSize="30"
                        FontWeight="Bold"
                        Width="100"
                        Height="45"
                        Margin="20 0 400 0">
                        ←
                    </Button>

                    <Button x:Name="Bouton_Valider"
                        Style="{StaticResource PrimaryButton}"
                        Click="Bouton_Valider_Click"
                        Width="200"
                        Height="45"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,20,0">
                        Valider
                    </Button>
                </StackPanel>
            </StackPanel>
        </Viewbox>
    </Grid>
</Window>
