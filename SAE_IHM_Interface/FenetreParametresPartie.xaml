<Window x:Class="SAE_IHM_Interface.FenetreParametresPartie"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SAE_IHM_Interface"
        mc:Ignorable="d"
        Title="Paramètres de la partie"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource AppBackground}"
        FontFamily="Segoe UI"
        Height="450"
        Width="800">

    <Window.Resources>

        <Style x:Key="SpinnerButton" TargetType="Button">
            <Setter Property="Background" Value="#EDEDED"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">

                            <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#f4f5f6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="20,0,20,0">
        <Viewbox Stretch="Uniform"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                Height="400">

                <StackPanel Orientation="Vertical">

                    <Grid Margin="0,10,0,20">
                        <Border BorderBrush="Black"
                            BorderThickness="2"
                            CornerRadius="8"
                            Background="White"
                            Padding="20">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="250"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                    Text="Nombre de jetons"
                                    FontSize="14"
                                    VerticalAlignment="Center"/>

                                <Border Grid.Column="1"
                                    BorderBrush="Black"
                                    BorderThickness="1"
                                    CornerRadius="2"
                                    Height="26">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="18"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBox x:Name="SpinnerJetons"
                                            Grid.Column="0"
                                            Text="4"
                                            BorderThickness="0"
                                            VerticalContentAlignment="Center"
                                            Padding="10,0"
                                            FontSize="13"/>

                                        <Grid Grid.Column="1">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <Button Grid.Row="0"
                                                Content="▲"
                                                FontSize="8"
                                                Style="{StaticResource SpinnerButton}"
                                                Click="SpinnerJetons_Up_Click"/>

                                            <Button Grid.Row="1"
                                                Content="▼"
                                                FontSize="8"
                                                Style="{StaticResource SpinnerButton}"
                                                Click="SpinnerJetons_Down_Click"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>

                        </Border>

                        <TextBlock Text="Nombres de jetons"
                            FontSize="13"
                            FontWeight="Bold"
                            Background="White"
                            Padding="5,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="20,-10,0,0"/>
                    </Grid>

                    <Grid Margin="0,10,0,20">
                        <Border BorderBrush="Black"
                            BorderThickness="2"
                            CornerRadius="8"
                            Background="White"
                            Padding="20">

                            <StackPanel Orientation="Vertical">

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="250"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                        Text="Longueur"
                                        FontSize="14"
                                        VerticalAlignment="Center"/>

                                    <Border Grid.Column="1"
                                        BorderBrush="Black"
                                        BorderThickness="1"
                                        CornerRadius="2"
                                        Height="26">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="18"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBox x:Name="SpinnerLongueur"
                                                Grid.Column="0"
                                                Text="5"
                                                BorderThickness="0"
                                                VerticalContentAlignment="Center"
                                                Padding="10,0"
                                                FontSize="13"/>

                                            <Grid Grid.Column="1">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>

                                                <Button Grid.Row="0"
                                                    Content="▲"
                                                    FontSize="8"
                                                    Style="{StaticResource SpinnerButton}"
                                                    Click="SpinnerLongueur_Up_Click"/>

                                                <Button Grid.Row="1"
                                                    Content="▼"
                                                    FontSize="8"
                                                    Style="{StaticResource SpinnerButton}"
                                                    Click="SpinnerLongueur_Down_Click"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="250"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                        Text="Largeur"
                                        FontSize="14"
                                        VerticalAlignment="Center"/>

                                    <Border Grid.Column="1"
                                        BorderBrush="Black"
                                        BorderThickness="1"
                                        CornerRadius="2"
                                        Height="26">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="18"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBox x:Name="SpinnerLargeur"
                                                Grid.Column="0"
                                                Text="7"
                                                BorderThickness="0"
                                                VerticalContentAlignment="Center"
                                                Padding="10,0"
                                                FontSize="13"/>

                                            <Grid Grid.Column="1">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>

                                                <Button Grid.Row="0"
                                                    Content="▲"
                                                    FontSize="8"
                                                    Style="{StaticResource SpinnerButton}"
                                                    Click="SpinnerLargeur_Up_Click"/>

                                                <Button Grid.Row="1"
                                                    Content="▼"
                                                    FontSize="8"
                                                    Style="{StaticResource SpinnerButton}"
                                                    Click="SpinnerLargeur_Down_Click"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Grid>

                            </StackPanel>
                        </Border>

                        <TextBlock Text="Taille grille"
                            FontSize="13"
                            FontWeight="Bold"
                            Background="White"
                            Padding="5,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="20,-10,0,0"/>
                    </Grid>

                    <Grid Margin="0,7,0,20">
                        <Border BorderBrush="Black"
                            BorderThickness="2"
                            CornerRadius="8"
                            Background="White"
                            Padding="20">

                            <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">

                                <CheckBox x:Name="CheckModeChallenge"
                                    Content="Mode Challenge"
                                    FontSize="14"
                                    VerticalAlignment="Center"
                                    Margin="20,0,120,0"
                                    Checked="CheckModeChallenge_Changed"
                                    Unchecked="CheckModeChallenge_Changed"/>

                                <TextBlock Text="Nombre de manche"
                                    FontSize="13"
                                    Foreground="Black"
                                    VerticalAlignment="Center"
                                    Margin="0,0,20,0"/>

                                <Border x:Name="BorderManche"
                                    BorderBrush="#999999"
                                    BorderThickness="1"
                                    CornerRadius="2"
                                    Height="26"
                                    Width="80"
                                    Opacity="0.4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="18"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBox x:Name="SpinnerManche"
                                            Grid.Column="0"
                                            Text="3"
                                            BorderThickness="0"
                                            VerticalContentAlignment="Center"
                                            Padding="6,0"
                                            FontSize="13"
                                            IsEnabled="False"/>

                                        <Grid Grid.Column="1">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <Button Grid.Row="0"
                                                x:Name="BtnMancheUp"
                                                Content="▲"
                                                FontSize="8"
                                                Style="{StaticResource SpinnerButton}"
                                                IsEnabled="False"
                                                Click="SpinnerManche_Up_Click"/>

                                            <Button Grid.Row="1"
                                                x:Name="BtnMancheDown"
                                                Content="▼"
                                                FontSize="8"
                                                Style="{StaticResource SpinnerButton}"
                                                IsEnabled="False"
                                                Click="SpinnerManche_Down_Click"/>
                                        </Grid>
                                    </Grid>
                                </Border>

                            </StackPanel>
                        </Border>

                        <TextBlock Text="Mode"
                            FontSize="13"
                            FontWeight="Bold"
                            Background="White"
                            Padding="5,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="20,-10,0,0"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">

                        <Button x:Name="Bouton_retour"
                            Click="Bouton_retour_Click"
                            FontSize="30"
                            FontWeight="Bold"
                            Width="100"
                            Height="45"
                            Margin="20, 0, 400, 0">
                            ←
                        </Button>

                        <Button x:Name="Bouton_Valider"
                            Style="{StaticResource PrimaryButton}"
                            Click="Bouton_Valider_Click"
                            Width="200"
                            Height="45"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,20,0">
                            Valider
                        </Button>
                    </StackPanel>
                </StackPanel>

            </ScrollViewer>
        </Viewbox>
    </Grid>
</Window>
